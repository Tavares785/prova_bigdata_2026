# ============================================================
# .gitignore da prova prática de Big Data na AWS
# ============================================================

# --- Artefatos do Terraform (nunca versionar) ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan

# Arquivos de variáveis com valores reais (usar apenas *.example)
*.tfvars
*.tfvars.json
!*.tfvars.example

# --- Credenciais AWS do Learner Lab (NUNCA versionar) ---
# As credenciais temporárias (Access Key, Secret Key e aws_session_token)
# expiram a cada sessão e não devem ser commitadas. Reforça Req 11.4.
.aws/
credentials
*.pem
*.credentials
aws_credentials*
.env
.env.*

# --- Python / PySpark (teste local) ---
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
venv/
.venv/
*.egg-info/

# --- Spark local ---
derby.log
metastore_db/
spark-warehouse/

# --- Utilitarios locais do aluno (scripts de apoio, nao versionar) ---
setup_creds.sh
run_job.sh
run_athena.sh
wait_job.sh
diag_athena.sh
logs_job.sh
del_item.sh
gerar_evidencias.sh
add_evidencia_infra.sh

# --- Harness de teste local (nao faz parte da entrega) ---
local-test/normaliza_pedidos_aluno.py
local-test/test_aluno.py

# --- Arquivos soltos acidentais ---
/f
/gold.tf
/variables.tf
pr_body.md
