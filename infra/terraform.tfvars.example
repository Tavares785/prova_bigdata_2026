# terraform.tfvars.example — infra (prova)
#
# Copie para terraform.tfvars e ajuste:
#   cp terraform.tfvars.example terraform.tfvars
#
# ⚠️ NUNCA versione credenciais. As credenciais temporárias do Learner Lab
#    (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN) vêm de
#    variáveis de ambiente ou ~/.aws/credentials — nunca deste arquivo.
#    terraform.tfvars está no .gitignore — não o commite.
#
# Este exemplo cobre a camada raw fornecida e as variáveis da camada gold desta entrega.

# Região obrigatória do Learner Lab.
regiao = "us-east-1"

# Nome GLOBALMENTE único do bucket raw (troque SEURA pelo seu RA).
bucket_raw_nome = "prova-bigdata-raw-SEURA"

# Troque o sufixo por um identificador globalmente unico da sua conta.
bucket_gold_nome = "prova-bigdata-gold-6325231-sufixo-unico"
labrole_arn      = "arn:aws:iam::123456789012:role/LabRole"
tags = {
  Projeto    = "prova-bigdata-6325231"
  Disciplina = "BigData"
  Ambiente   = "LearnerLab"
}
