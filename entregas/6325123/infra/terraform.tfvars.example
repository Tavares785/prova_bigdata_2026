# terraform.tfvars.example — infra (prova)
#
# Copie para terraform.tfvars e ajuste:
#   cp terraform.tfvars.example terraform.tfvars
#
# ⚠️ NUNCA versione credenciais. As credenciais temporárias do Learner Lab
#    (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN) vêm de
#    variáveis de ambiente ou ~/.aws/credentials — nunca deste arquivo.
#    terraform.tfvars está no .gitignore — não o commite.
#
# Este exemplo cobre apenas a camada raw (PRONTA). Ao construir a sua infra,
# adicione aqui os valores das variáveis que VOCÊ declarar.

# Região obrigatória do Learner Lab.
regiao = "us-east-1"

# Nome GLOBALMENTE único do bucket raw (troque SEURA pelo seu RA).
bucket_raw_nome = "prova-bigdata-raw-6325123"

# Nome GLOBALMENTE único do bucket gold.
bucket_gold_nome = "prova-bigdata-gold-6325123"

# ARN da LabRole fornecida pelo AWS Academy Learner Lab.
# Preencha com o ARN da sua LabRole quando iniciar o Lab.
labrole_arn = "arn:aws:iam::SEU_ACCOUNT_ID:role/LabRole"

# Tags obrigatórias da prova.
tags = {
  Projeto    = "prova-bigdata-2026"
  Disciplina = "Big Data"
  Ambiente   = "Learner Lab"
}