# terraform.tfvars.example — infra (prova)
#
# Copie para terraform.tfvars e ajuste:
#   cp terraform.tfvars.example terraform.tfvars
#
# ⚠️ NUNCA versione credenciais. As credenciais temporárias do Learner Lab
#    (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN) vêm de
#    variáveis de ambiente ou ~/.aws/credentials — nunca deste arquivo.
#    terraform.tfvars está no .gitignore — não o commite.
#
# Este exemplo cobre apenas a camada raw (PRONTA). Ao construir a sua infra,
# adicione aqui os valores das variáveis que VOCÊ declarar.

# Região obrigatória do Learner Lab.
regiao = "us-east-1"

# Nomes GLOBALMENTE únicos dos buckets (troque SEURA pelo seu RA).
bucket_raw_nome  = "prova-bigdata-raw-SEURA"
bucket_gold_nome = "prova-bigdata-gold-SEURA"

# ARN da LabRole do AWS Academy. Troque <ACCOUNT_ID> pelo seu ID da AWS.
labrole_arn = "arn:aws:iam::<ACCOUNT_ID>:role/LabRole"

# Nome da tabela do DynamoDB
dynamodb_table_nome = "execucoes"

# Tags obrigatórias de identificação
tags = {
  Projeto    = "Infraestrutura-AWS"
  Disciplina = "DevOps e Cloud Computing"
  Ambiente   = "Desenvolvimento"
}